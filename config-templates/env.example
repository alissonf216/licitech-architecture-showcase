# =============================================================================
# env.example — PLACEHOLDERS ONLY
# -----------------------------------------------------------------------------
# Copy to a local .env that is NEVER committed.
# Replace every value. Empty or example:// URLs are intentional.
# =============================================================================

# --- Runtime ---------------------------------------------------------------
APP_ENV=development
APP_NAME=licitera
LOG_LEVEL=info
LOG_FORMAT=json

# --- HTTP ------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=https://app.example.com

# --- Database (managed Postgres preferred) ---------------------------------
# EXAMPLE — do not use these credentials anywhere real
DATABASE_URL=postgresql://USER:PASSWORD@db.example.com:5432/DATABASE?sslmode=require
DATABASE_POOL_SIZE=10
DATABASE_POOL_MAX_OVERFLOW=5

# --- Auth / JWT ------------------------------------------------------------
# Issued by your identity provider — never hardcode production secrets
JWT_ISSUER=https://auth.example.com
JWT_AUDIENCE=licitera-api
JWT_JWKS_URL=https://auth.example.com/.well-known/jwks.json
SUPABASE_URL=https://YOUR_PROJECT.example.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# --- Redis / Queue ---------------------------------------------------------
REDIS_URL=redis://redis:6379/0
QUEUE_NAME=licitera-jobs
WORKER_CONCURRENCY=4
JOB_MAX_RETRIES=5

# --- Object storage --------------------------------------------------------
STORAGE_BUCKET=example-bucket
STORAGE_ENDPOINT=https://storage.example.com

# --- Observability ---------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com:4317
METRICS_ENABLED=true

# --- Feature flags ---------------------------------------------------------
FEATURE_ASYNC_INGEST=true
FEATURE_NOTIFICATIONS=true

# --- Rate limits -----------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120
